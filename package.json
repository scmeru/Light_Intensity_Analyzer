{
  "name": "light-intensity-analyzer",
  "private": true,
  "version": "1.0.0",
  "description": "Analisis Intensitas Cahaya & Fisika Interferensi",
  "author": "Yusuf",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:preview": "npm run build && electron .",
    "electron:build": "node scripts/setup-winsign.js && npm run build && electron-builder --win portable --x64"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "electron": "^36.0.0",
    "electron-builder": "^25.0.0",
    "svelte": "^5.55.1",
    "vite": "^8.0.4"
  },
  "build": {
    "appId": "com.lightscope.analyzer",
    "productName": "LightScope",
    "copyright": "Yusuf — Light Intensity Analyzer",
    "directories": {
      "output": "electron-dist",
      "buildResources": "public"
    },
    "files": [
      "dist/**/*",
      "electron/main.cjs"
    ],
    "win": {
      "icon": "public/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "portable": {
      "artifactName": "LightScope-${version}-portable.exe"
    }
  }
}
